        <dc:Bounds x="360" y="240" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_gw_parallel_start" bpmnElement="gw_parallel_field_start" isMarkerVisible="true">
        <dc:Bounds x="560" y="680" width="40" height="40"/>
      </bpmndi:BPMNShape>
      <!-- Phase 0a -->
      <bpmndi:BPMNShape id="shape_communiquer_terrain" bpmnElement="task_communiquer_realite_terrain">
        <dc:Bounds x="640" y="2340" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_transmettre_analyse" bpmnElement="task_transmettre_analyse_donnees">
        <dc:Bounds x="840" y="2340" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <!-- Phase 0b -->
      <bpmndi:BPMNShape id="shape_transmettre_dispo" bpmnElement="task_transmettre_disponibilites">
