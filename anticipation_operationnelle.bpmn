      <bpmndi:BPMNEdge id="edge_info_entrer" bpmnElement="sf_transmettre_info_to_entrer">
        <di:waypoint x="1200" y="740"/><di:waypoint x="1200" y="1140"/>
      </bpmndi:BPMNEdge>
      <!-- Phase 1 -->
      <bpmndi:BPMNEdge id="edge_entrer_valider" bpmnElement="sf_entrer_to_valider">
        <di:waypoint x="1200" y="1220"/><di:waypoint x="1200" y="1640"/>
