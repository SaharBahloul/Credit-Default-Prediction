      <bpmndi:BPMNEdge id="edge_emettre_transmettre" bpmnElement="sf_emettre_to_transmettre_ordre">
        <di:waypoint x="240" y="320"/><di:waypoint x="240" y="660"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_transmettre_recevoir" bpmnElement="sf_transmettre_ordre_to_parallel_start">
        <di:waypoint x="320" y="700"/><di:waypoint x="360" y="280"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_recevoir_parallel" bpmnElement="sf_recevoir_to_parallel">
        <di:waypoint x="520" y="280"/><di:waypoint x="580" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_parallel_communiquer" bpmnElement="sf_parallel_to_communiquer">
