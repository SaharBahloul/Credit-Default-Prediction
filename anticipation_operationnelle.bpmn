<?xml version="1.0" encoding="UTF-8"?>
<!--
  BPMN 2.0 – Processus d'Anticipation Opérationnelle
  Transformé depuis :
    - Diagramme d'activités (swim-lanes)
    - Diagramme de séquence
    - Diagramme de cas d'utilisation

  Participants / Lanes :
    1. COS (Commandant des Opérations de Secours)
    2. Chef du PC
    3. Officier Anticipation
    4. Système d'Anticipation
    5. Officier Moyen
    6. Officiers Action et Renseignement

  Boucles de validation (XOR gateways) :
    - SE (Situations Envisageables)
    - Objectifs
    - IM + DTA (Idées de Manœuvre + Dispositifs Tactiques d'Action)
-->
<definitions
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  targetNamespace="http://anticipation-operationnelle/bpmn"
  exporter="BPMN 2.0 Manual"
  exporterVersion="1.0">

  <!-- ═══════════════════════════════════════════════════════════
       COLLABORATION  (one pool, six lanes)
  ═══════════════════════════════════════════════════════════ -->
  <collaboration id="collab_anticipation">
    <participant id="pool_anticipation"
                 name="Travail d'Intervention – Anticipation Opérationnelle"
                 processRef="proc_anticipation"/>
  </collaboration>

  <!-- ═══════════════════════════════════════════════════════════
       PROCESS
  ═══════════════════════════════════════════════════════════ -->
  <process id="proc_anticipation" name="Processus d'Anticipation Opérationnelle"
           isExecutable="false">

    <!-- ── LANE SET ─────────────────────────────────────────── -->
    <laneSet id="laneSet1">

      <!-- Lane 1 : COS -->
      <lane id="lane_cos" name="COS">
        <flowNodeRef>start1</flowNodeRef>
        <flowNodeRef>task_emettre_ordre</flowNodeRef>
        <flowNodeRef>task_recevoir_retour_informations</flowNodeRef>
        <flowNodeRef>gw_se_validees</flowNodeRef>
        <flowNodeRef>task_approuver_se</flowNodeRef>
        <flowNodeRef>task_envoyer_retour_correction_se</flowNodeRef>
        <flowNodeRef>gw_objectifs_approuves</flowNodeRef>
        <flowNodeRef>task_approuver_objectifs</flowNodeRef>
        <flowNodeRef>task_envoyer_retour_correction_obj</flowNodeRef>
        <flowNodeRef>gw_im_dta_approuves</flowNodeRef>
        <flowNodeRef>task_approuver_im_dta</flowNodeRef>
        <flowNodeRef>task_envoyer_retour_correction_im_dta</flowNodeRef>
        <flowNodeRef>task_arreter_decision</flowNodeRef>
      </lane>

      <!-- Lane 2 : Chef du PC -->
      <lane id="lane_chef_pc" name="Chef du PC">
        <flowNodeRef>task_transmettre_ordre_cos</flowNodeRef>
        <flowNodeRef>gw_parallel_field_start</flowNodeRef>
        <flowNodeRef>gw_parallel_field_end</flowNodeRef>
        <flowNodeRef>task_transmettre_informations</flowNodeRef>
        <flowNodeRef>task_transmettre_se</flowNodeRef>
        <flowNodeRef>task_transmettre_corrections_se</flowNodeRef>
        <flowNodeRef>task_transmettre_se_approuves</flowNodeRef>
        <flowNodeRef>task_transmettre_objectifs</flowNodeRef>
        <flowNodeRef>task_transmettre_corrections_obj</flowNodeRef>
        <flowNodeRef>task_transmettre_objectifs_approuves</flowNodeRef>
        <flowNodeRef>task_transmettre_im_dta</flowNodeRef>
        <flowNodeRef>task_transmettre_corrections_im_dta</flowNodeRef>
        <flowNodeRef>task_transmettre_decision_finale</flowNodeRef>
      </lane>

      <!-- Lane 3 : Officier Anticipation -->
      <lane id="lane_anticipation" name="Officier Anticipation">
        <flowNodeRef>task_entrer_informations</flowNodeRef>
        <flowNodeRef>task_demander_se</flowNodeRef>
        <flowNodeRef>task_proposer_se</flowNodeRef>
        <flowNodeRef>task_demander_objectifs</flowNodeRef>
        <flowNodeRef>task_proposer_objectifs</flowNodeRef>
        <flowNodeRef>task_demander_im_dta</flowNodeRef>
        <flowNodeRef>task_proposer_im_dta</flowNodeRef>
      </lane>

      <!-- Lane 4 : Système d'Anticipation -->
      <lane id="lane_systeme" name="Système d'Anticipation">
        <flowNodeRef>task_valider_stocker</flowNodeRef>
        <flowNodeRef>task_generer_se</flowNodeRef>
        <flowNodeRef>task_generer_objectifs</flowNodeRef>
        <flowNodeRef>task_generer_im_dta</flowNodeRef>
      </lane>

      <!-- Lane 5 : Officier Moyen -->
      <lane id="lane_moyen" name="Officier Moyen">
        <flowNodeRef>task_transmettre_disponibilites</flowNodeRef>
      </lane>

      <!-- Lane 6 : Officiers Action et Renseignement -->
      <lane id="lane_action_renseignement" name="Officiers Action et Renseignement">
        <flowNodeRef>task_communiquer_realite_terrain</flowNodeRef>
        <flowNodeRef>task_transmettre_analyse_donnees</flowNodeRef>
        <flowNodeRef>task_executer_decision</flowNodeRef>
        <flowNodeRef>end1</flowNodeRef>
      </lane>

    </laneSet>

    <!-- ══════════════════════════════════════════════════════
         EVENTS
    ══════════════════════════════════════════════════════ -->

    <!-- Start : nouvelle situation ou émission d'un ordre initial par le COS -->
    <startEvent id="start1" name="Nouvelle situation /&#10;émettre un ordre initial">
      <outgoing>sf_start_to_emettre</outgoing>
    </startEvent>

    <!-- End : décision du COS exécutée -->
    <endEvent id="end1" name="Fin – Décision du COS exécutée">
      <incoming>sf_executer_to_end</incoming>
    </endEvent>

    <!-- ══════════════════════════════════════════════════════
         PHASE 0 – ÉMISSION DE L'ORDRE INITIAL
    ══════════════════════════════════════════════════════ -->

    <!-- COS : émet l'ordre initial -->
    <task id="task_emettre_ordre" name="Émettre un ordre initial">
      <incoming>sf_start_to_emettre</incoming>
      <outgoing>sf_emettre_to_transmettre_ordre</outgoing>
    </task>

    <!-- Chef du PC : transmet l'ordre du COS -->
    <task id="task_transmettre_ordre_cos" name="Transmettre l'ordre du COS">
      <incoming>sf_emettre_to_transmettre_ordre</incoming>
      <outgoing>sf_transmettre_ordre_to_parallel_start</outgoing>
    </task>

    <!-- COS : reçoit les informations (retour du terrain) -->
    <task id="task_recevoir_retour_informations" name="Recevoir les informations">
      <incoming>sf_transmettre_ordre_to_parallel_start</incoming>
      <outgoing>sf_recevoir_to_parallel</outgoing>
    </task>

    <!-- ── Parallel gateway : collect field information in parallel ── -->
    <parallelGateway id="gw_parallel_field_start" name="Collecte informations terrain (début)">
      <incoming>sf_recevoir_to_parallel</incoming>
      <outgoing>sf_parallel_to_communiquer</outgoing>
      <outgoing>sf_parallel_to_disponibilites</outgoing>
    </parallelGateway>

    <!-- ══════════════════════════════════════════════════════
         PHASE 0a – OFFICIERS ACTION ET RENSEIGNEMENT
    ══════════════════════════════════════════════════════ -->

    <task id="task_communiquer_realite_terrain" name="Communiquer réalité terrain">
      <incoming>sf_parallel_to_communiquer</incoming>
      <outgoing>sf_communiquer_to_analyse</outgoing>
    </task>

    <task id="task_transmettre_analyse_donnees" name="Transmettre l'analyse des données">
      <incoming>sf_communiquer_to_analyse</incoming>
      <outgoing>sf_analyse_to_parallel_end</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         PHASE 0b – OFFICIER MOYEN
    ══════════════════════════════════════════════════════ -->

    <task id="task_transmettre_disponibilites"
          name="Transmettre la disponibilité&#10;et l'évolution des moyens">
      <incoming>sf_parallel_to_disponibilites</incoming>
      <outgoing>sf_disponibilites_to_parallel_end</outgoing>
    </task>

    <!-- Parallel join -->
    <parallelGateway id="gw_parallel_field_end" name="Collecte informations terrain (fin)">
      <incoming>sf_analyse_to_parallel_end</incoming>
      <incoming>sf_disponibilites_to_parallel_end</incoming>
      <outgoing>sf_parallel_end_to_transmettre_info</outgoing>
    </parallelGateway>

    <!-- Chef du PC : transmet les informations consolidées -->
    <task id="task_transmettre_informations" name="Transmettre les informations">
      <incoming>sf_parallel_end_to_transmettre_info</incoming>
      <outgoing>sf_transmettre_info_to_entrer</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         PHASE 1 – SITUATIONS ENVISAGEABLES (SE)
    ══════════════════════════════════════════════════════ -->

    <!-- Officier Anticipation : entre les informations dans le système -->
    <task id="task_entrer_informations" name="Entrer les informations">
      <incoming>sf_transmettre_info_to_entrer</incoming>
      <outgoing>sf_entrer_to_valider</outgoing>
    </task>

    <!-- Système d'Anticipation : valide et stocke -->
    <task id="task_valider_stocker" name="Valider et stocker">
      <incoming>sf_entrer_to_valider</incoming>
      <outgoing>sf_valider_to_demander_se</outgoing>
    </task>

    <!-- Officier Anticipation : demande la génération du tableau des SE -->
    <task id="task_demander_se" name="Demander une proposition&#10;du tableau des SE">
      <incoming>sf_valider_to_demander_se</incoming>
      <incoming>sf_corrections_se_to_demander_se</incoming>
      <outgoing>sf_demander_se_to_generer</outgoing>
    </task>

    <!-- Système d'Anticipation : génère les SE -->
    <task id="task_generer_se" name="Générer les SE">
      <incoming>sf_demander_se_to_generer</incoming>
      <outgoing>sf_generer_se_to_transmettre</outgoing>
    </task>

    <!-- Chef du PC : transmet les SE au COS -->
    <task id="task_transmettre_se" name="Transmettre les SE">
      <incoming>sf_generer_se_to_transmettre</incoming>
      <outgoing>sf_transmettre_se_to_proposer</outgoing>
    </task>

    <!-- Officier Anticipation : propose les SE -->
    <task id="task_proposer_se" name="Proposer les SE">
      <incoming>sf_transmettre_se_to_proposer</incoming>
      <outgoing>sf_proposer_se_to_gw</outgoing>
    </task>

    <!-- COS : SE validées ? -->
    <exclusiveGateway id="gw_se_validees" name="SE validées ?">
      <incoming>sf_proposer_se_to_gw</incoming>
      <outgoing>sf_se_oui</outgoing>
      <outgoing>sf_se_non</outgoing>
    </exclusiveGateway>

    <!-- [OUI] COS approuve les SE -->
    <task id="task_approuver_se" name="Approuver les SE">
      <incoming>sf_se_oui</incoming>
      <outgoing>sf_approuver_se_to_transmettre_approuves</outgoing>
    </task>

    <!-- [NON] COS envoie un retour de correction -->
    <task id="task_envoyer_retour_correction_se" name="Envoyer retour correction (SE)">
      <incoming>sf_se_non</incoming>
      <outgoing>sf_retour_se_to_corrections</outgoing>
    </task>

    <!-- Chef du PC : transmet les corrections -->
    <task id="task_transmettre_corrections_se" name="Transmettre les corrections (SE)">
      <incoming>sf_retour_se_to_corrections</incoming>
      <outgoing>sf_corrections_se_to_demander_se</outgoing>
    </task>

    <!-- Chef du PC : transmet les SE approuvés -->
    <task id="task_transmettre_se_approuves" name="Transmettre les SE approuvés">
      <incoming>sf_approuver_se_to_transmettre_approuves</incoming>
      <outgoing>sf_se_approuves_to_demander_obj</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         PHASE 2 – OBJECTIFS
    ══════════════════════════════════════════════════════ -->

    <!-- Officier Anticipation : demande la génération des objectifs -->
    <task id="task_demander_objectifs" name="Demander une proposition&#10;des objectifs">
      <incoming>sf_se_approuves_to_demander_obj</incoming>
      <incoming>sf_corrections_obj_to_demander_obj</incoming>
      <outgoing>sf_demander_obj_to_generer</outgoing>
    </task>

    <!-- Système d'Anticipation : génère les objectifs -->
    <task id="task_generer_objectifs" name="Générer les objectifs">
      <incoming>sf_demander_obj_to_generer</incoming>
      <outgoing>sf_generer_obj_to_proposer</outgoing>
    </task>

    <!-- Officier Anticipation : propose les objectifs -->
    <task id="task_proposer_objectifs" name="Proposer les objectifs">
      <incoming>sf_generer_obj_to_proposer</incoming>
      <outgoing>sf_proposer_obj_to_transmettre</outgoing>
    </task>

    <!-- Chef du PC : transmet les objectifs au COS -->
    <task id="task_transmettre_objectifs" name="Transmettre les objectifs">
      <incoming>sf_proposer_obj_to_transmettre</incoming>
      <outgoing>sf_transmettre_obj_to_gw</outgoing>
    </task>

    <!-- COS : Objectifs approuvés ? -->
    <exclusiveGateway id="gw_objectifs_approuves" name="Objectifs approuvés ?">
      <incoming>sf_transmettre_obj_to_gw</incoming>
      <outgoing>sf_obj_oui</outgoing>
      <outgoing>sf_obj_non</outgoing>
    </exclusiveGateway>

    <!-- [OUI] COS approuve les objectifs -->
    <task id="task_approuver_objectifs" name="Approuver les objectifs">
      <incoming>sf_obj_oui</incoming>
      <outgoing>sf_approuver_obj_to_transmettre_approuves</outgoing>
    </task>

    <!-- [NON] COS envoie un retour de correction -->
    <task id="task_envoyer_retour_correction_obj" name="Envoyer retour correction (Objectifs)">
      <incoming>sf_obj_non</incoming>
      <outgoing>sf_retour_obj_to_corrections</outgoing>
    </task>

    <!-- Chef du PC : transmet les corrections -->
    <task id="task_transmettre_corrections_obj" name="Transmettre les corrections (Objectifs)">
      <incoming>sf_retour_obj_to_corrections</incoming>
      <outgoing>sf_corrections_obj_to_demander_obj</outgoing>
    </task>

    <!-- Chef du PC : transmet les objectifs approuvés -->
    <task id="task_transmettre_objectifs_approuves" name="Transmettre les objectifs approuvés">
      <incoming>sf_approuver_obj_to_transmettre_approuves</incoming>
      <outgoing>sf_obj_approuves_to_demander_im_dta</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         PHASE 3 – IM + DTA (Idées de Manœuvre + Dispositifs Tactiques d'Action)
    ══════════════════════════════════════════════════════ -->

    <!-- Officier Anticipation : demande la génération des IM + DTA -->
    <task id="task_demander_im_dta" name="Demander une proposition&#10;des IM + DTA">
      <incoming>sf_obj_approuves_to_demander_im_dta</incoming>
      <incoming>sf_corrections_im_dta_to_demander</incoming>
      <outgoing>sf_demander_im_dta_to_generer</outgoing>
    </task>

    <!-- Système d'Anticipation : génère les IM + DTA -->
    <task id="task_generer_im_dta" name="Générer les IM + DTA">
      <incoming>sf_demander_im_dta_to_generer</incoming>
      <outgoing>sf_generer_im_dta_to_proposer</outgoing>
    </task>

    <!-- Officier Anticipation : propose les IM + DTA -->
    <task id="task_proposer_im_dta" name="Proposer les IM + DTA">
      <incoming>sf_generer_im_dta_to_proposer</incoming>
      <outgoing>sf_proposer_im_dta_to_transmettre</outgoing>
    </task>

    <!-- Chef du PC : transmet les IM + DTA au COS -->
    <task id="task_transmettre_im_dta" name="Transmettre les IM + DTA">
      <incoming>sf_proposer_im_dta_to_transmettre</incoming>
      <outgoing>sf_transmettre_im_dta_to_gw</outgoing>
    </task>

    <!-- COS : IM + DTA approuvés ? -->
    <exclusiveGateway id="gw_im_dta_approuves" name="IM + DTA approuvés ?">
      <incoming>sf_transmettre_im_dta_to_gw</incoming>
      <outgoing>sf_im_dta_oui</outgoing>
      <outgoing>sf_im_dta_non</outgoing>
    </exclusiveGateway>

    <!-- [OUI] COS approuve les IM + DTA -->
    <task id="task_approuver_im_dta" name="Approuver les IM + DTA">
      <incoming>sf_im_dta_oui</incoming>
      <outgoing>sf_approuver_im_dta_to_arreter</outgoing>
    </task>

    <!-- [NON] COS envoie un retour de correction -->
    <task id="task_envoyer_retour_correction_im_dta" name="Envoyer retour correction (IM + DTA)">
      <incoming>sf_im_dta_non</incoming>
      <outgoing>sf_retour_im_dta_to_corrections</outgoing>
    </task>

    <!-- Chef du PC : transmet les corrections -->
    <task id="task_transmettre_corrections_im_dta" name="Transmettre les corrections (IM + DTA)">
      <incoming>sf_retour_im_dta_to_corrections</incoming>
      <outgoing>sf_corrections_im_dta_to_demander</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         PHASE 4 – DÉCISION FINALE ET EXÉCUTION
    ══════════════════════════════════════════════════════ -->

    <!-- COS : arrête sa décision -->
    <task id="task_arreter_decision" name="Arrêter sa décision">
      <incoming>sf_approuver_im_dta_to_arreter</incoming>
      <outgoing>sf_arreter_to_transmettre_decision</outgoing>
    </task>

    <!-- Chef du PC : transmet la décision finale -->
    <task id="task_transmettre_decision_finale" name="Transmettre la décision finale">
      <incoming>sf_arreter_to_transmettre_decision</incoming>
      <outgoing>sf_decision_to_executer</outgoing>
    </task>

    <!-- Officiers Action et Renseignement : exécutent la décision du COS -->
    <task id="task_executer_decision" name="Exécuter la décision du COS">
      <incoming>sf_decision_to_executer</incoming>
      <outgoing>sf_executer_to_end</outgoing>
    </task>

    <!-- ══════════════════════════════════════════════════════
         SEQUENCE FLOWS
    ══════════════════════════════════════════════════════ -->

    <!-- Phase 0 – initialisation -->
    <sequenceFlow id="sf_start_to_emettre"
                  sourceRef="start1" targetRef="task_emettre_ordre"/>
    <sequenceFlow id="sf_emettre_to_transmettre_ordre"
                  sourceRef="task_emettre_ordre" targetRef="task_transmettre_ordre_cos"/>
    <sequenceFlow id="sf_transmettre_ordre_to_parallel_start"
                  sourceRef="task_transmettre_ordre_cos" targetRef="task_recevoir_retour_informations"/>
    <sequenceFlow id="sf_recevoir_to_parallel"
                  sourceRef="task_recevoir_retour_informations" targetRef="gw_parallel_field_start"/>

    <!-- Phase 0a – Officiers Action et Renseignement -->
    <sequenceFlow id="sf_parallel_to_communiquer"
                  sourceRef="gw_parallel_field_start" targetRef="task_communiquer_realite_terrain"/>
    <sequenceFlow id="sf_communiquer_to_analyse"
                  sourceRef="task_communiquer_realite_terrain" targetRef="task_transmettre_analyse_donnees"/>
    <sequenceFlow id="sf_analyse_to_parallel_end"
                  sourceRef="task_transmettre_analyse_donnees" targetRef="gw_parallel_field_end"/>

    <!-- Phase 0b – Officier Moyen -->
    <sequenceFlow id="sf_parallel_to_disponibilites"
                  sourceRef="gw_parallel_field_start" targetRef="task_transmettre_disponibilites"/>
    <sequenceFlow id="sf_disponibilites_to_parallel_end"
                  sourceRef="task_transmettre_disponibilites" targetRef="gw_parallel_field_end"/>

    <!-- Jonction parallèle → Chef du PC -->
    <sequenceFlow id="sf_parallel_end_to_transmettre_info"
                  sourceRef="gw_parallel_field_end" targetRef="task_transmettre_informations"/>
    <sequenceFlow id="sf_transmettre_info_to_entrer"
                  sourceRef="task_transmettre_informations" targetRef="task_entrer_informations"/>

    <!-- Phase 1 – SE -->
    <sequenceFlow id="sf_entrer_to_valider"
                  sourceRef="task_entrer_informations" targetRef="task_valider_stocker"/>
    <sequenceFlow id="sf_valider_to_demander_se"
                  sourceRef="task_valider_stocker" targetRef="task_demander_se"/>
    <sequenceFlow id="sf_demander_se_to_generer"
                  sourceRef="task_demander_se" targetRef="task_generer_se"/>
    <sequenceFlow id="sf_generer_se_to_transmettre"
                  sourceRef="task_generer_se" targetRef="task_transmettre_se"/>
    <sequenceFlow id="sf_transmettre_se_to_proposer"
                  sourceRef="task_transmettre_se" targetRef="task_proposer_se"/>
    <sequenceFlow id="sf_proposer_se_to_gw"
                  sourceRef="task_proposer_se" targetRef="gw_se_validees"/>
    <sequenceFlow id="sf_se_oui" name="Oui"
                  sourceRef="gw_se_validees" targetRef="task_approuver_se"/>
    <sequenceFlow id="sf_se_non" name="Non"
                  sourceRef="gw_se_validees" targetRef="task_envoyer_retour_correction_se"/>
    <sequenceFlow id="sf_retour_se_to_corrections"
                  sourceRef="task_envoyer_retour_correction_se" targetRef="task_transmettre_corrections_se"/>
    <sequenceFlow id="sf_corrections_se_to_demander_se"
                  sourceRef="task_transmettre_corrections_se" targetRef="task_demander_se"/>
    <sequenceFlow id="sf_approuver_se_to_transmettre_approuves"
                  sourceRef="task_approuver_se" targetRef="task_transmettre_se_approuves"/>
    <sequenceFlow id="sf_se_approuves_to_demander_obj"
                  sourceRef="task_transmettre_se_approuves" targetRef="task_demander_objectifs"/>

    <!-- Phase 2 – Objectifs -->
    <sequenceFlow id="sf_demander_obj_to_generer"
                  sourceRef="task_demander_objectifs" targetRef="task_generer_objectifs"/>
    <sequenceFlow id="sf_generer_obj_to_proposer"
                  sourceRef="task_generer_objectifs" targetRef="task_proposer_objectifs"/>
    <sequenceFlow id="sf_proposer_obj_to_transmettre"
                  sourceRef="task_proposer_objectifs" targetRef="task_transmettre_objectifs"/>
    <sequenceFlow id="sf_transmettre_obj_to_gw"
                  sourceRef="task_transmettre_objectifs" targetRef="gw_objectifs_approuves"/>
    <sequenceFlow id="sf_obj_oui" name="Oui"
                  sourceRef="gw_objectifs_approuves" targetRef="task_approuver_objectifs"/>
    <sequenceFlow id="sf_obj_non" name="Non"
                  sourceRef="gw_objectifs_approuves" targetRef="task_envoyer_retour_correction_obj"/>
    <sequenceFlow id="sf_retour_obj_to_corrections"
                  sourceRef="task_envoyer_retour_correction_obj" targetRef="task_transmettre_corrections_obj"/>
    <sequenceFlow id="sf_corrections_obj_to_demander_obj"
                  sourceRef="task_transmettre_corrections_obj" targetRef="task_demander_objectifs"/>
    <sequenceFlow id="sf_approuver_obj_to_transmettre_approuves"
                  sourceRef="task_approuver_objectifs" targetRef="task_transmettre_objectifs_approuves"/>
    <sequenceFlow id="sf_obj_approuves_to_demander_im_dta"
                  sourceRef="task_transmettre_objectifs_approuves" targetRef="task_demander_im_dta"/>

    <!-- Phase 3 – IM + DTA -->
    <sequenceFlow id="sf_demander_im_dta_to_generer"
                  sourceRef="task_demander_im_dta" targetRef="task_generer_im_dta"/>
    <sequenceFlow id="sf_generer_im_dta_to_proposer"
                  sourceRef="task_generer_im_dta" targetRef="task_proposer_im_dta"/>
    <sequenceFlow id="sf_proposer_im_dta_to_transmettre"
                  sourceRef="task_proposer_im_dta" targetRef="task_transmettre_im_dta"/>
    <sequenceFlow id="sf_transmettre_im_dta_to_gw"
                  sourceRef="task_transmettre_im_dta" targetRef="gw_im_dta_approuves"/>
    <sequenceFlow id="sf_im_dta_oui" name="Oui"
                  sourceRef="gw_im_dta_approuves" targetRef="task_approuver_im_dta"/>
    <sequenceFlow id="sf_im_dta_non" name="Non"
                  sourceRef="gw_im_dta_approuves" targetRef="task_envoyer_retour_correction_im_dta"/>
    <sequenceFlow id="sf_retour_im_dta_to_corrections"
                  sourceRef="task_envoyer_retour_correction_im_dta"
                  targetRef="task_transmettre_corrections_im_dta"/>
    <sequenceFlow id="sf_corrections_im_dta_to_demander"
                  sourceRef="task_transmettre_corrections_im_dta" targetRef="task_demander_im_dta"/>
    <sequenceFlow id="sf_approuver_im_dta_to_arreter"
                  sourceRef="task_approuver_im_dta" targetRef="task_arreter_decision"/>

    <!-- Phase 4 – Décision finale et exécution -->
    <sequenceFlow id="sf_arreter_to_transmettre_decision"
                  sourceRef="task_arreter_decision" targetRef="task_transmettre_decision_finale"/>
    <sequenceFlow id="sf_decision_to_executer"
                  sourceRef="task_transmettre_decision_finale" targetRef="task_executer_decision"/>
    <sequenceFlow id="sf_executer_to_end"
                  sourceRef="task_executer_decision" targetRef="end1"/>

  </process>

  <!-- ═══════════════════════════════════════════════════════════
       BPMN DIAGRAM INTERCHANGE  (layout / positions)
       Dimensions :  pool 1800 × 2800  (6 lanes of ~450 height each)
       X origin for each lane starts at x=160 (after lane label at x=0)
  ═══════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="diagram1" name="Anticipation Opérationnelle">
    <bpmndi:BPMNPlane id="plane1" bpmnElement="collab_anticipation">

      <!-- Pool -->
      <bpmndi:BPMNShape id="shape_pool" bpmnElement="pool_anticipation" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1800" height="2800"/>
      </bpmndi:BPMNShape>

      <!-- ── Lane shapes ───────────────────────────────────── -->
      <bpmndi:BPMNShape id="shape_lane_cos" bpmnElement="lane_cos" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1770" height="600"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_chef_pc" bpmnElement="lane_chef_pc" isHorizontal="true">
        <dc:Bounds x="30" y="600" width="1770" height="500"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_anticipation" bpmnElement="lane_anticipation" isHorizontal="true">
        <dc:Bounds x="30" y="1100" width="1770" height="500"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_systeme" bpmnElement="lane_systeme" isHorizontal="true">
        <dc:Bounds x="30" y="1600" width="1770" height="400"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_moyen" bpmnElement="lane_moyen" isHorizontal="true">
        <dc:Bounds x="30" y="2000" width="1770" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_action" bpmnElement="lane_action_renseignement" isHorizontal="true">
        <dc:Bounds x="30" y="2300" width="1770" height="500"/>
      </bpmndi:BPMNShape>

      <!-- ══ START EVENT ══ -->
      <bpmndi:BPMNShape id="shape_start1" bpmnElement="start1">
        <dc:Bounds x="80" y="260" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="56" y="302" width="86" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- ══ PHASE 0 ══ -->
      <bpmndi:BPMNShape id="shape_emettre_ordre" bpmnElement="task_emettre_ordre">
