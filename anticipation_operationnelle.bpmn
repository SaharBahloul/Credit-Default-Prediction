      <bpmndi:BPMNShape id="shape_retour_im_dta" bpmnElement="task_envoyer_retour_correction_im_dta">
        <dc:Bounds x="1240" y="120" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_corrections_im_dta" bpmnElement="task_transmettre_corrections_im_dta">
        <dc:Bounds x="960" y="900" width="160" height="80"/>
