      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_transmettre_se_proposer" bpmnElement="sf_transmettre_se_to_proposer">
        <di:waypoint x="640" y="660"/><di:waypoint x="640" y="1180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_proposer_se_gw" bpmnElement="sf_proposer_se_to_gw">
        <di:waypoint x="640" y="1140"/><di:waypoint x="780" y="278"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_se_oui" bpmnElement="sf_se_oui">
        <di:waypoint x="800" y="278"/><di:waypoint x="840" y="280"/>
        <bpmndi:BPMNLabel><dc:Bounds x="808" y="260" width="24" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_se_non" bpmnElement="sf_se_non">
        <di:waypoint x="780" y="258"/><di:waypoint x="780" y="160"/><di:waypoint x="840" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="786" y="200" width="24" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_retour_se_corrections" bpmnElement="sf_retour_se_to_corrections">
        <di:waypoint x="840" y="160"/><di:waypoint x="440" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_corrections_se_demander" bpmnElement="sf_corrections_se_to_demander_se">
        <di:waypoint x="440" y="740"/><di:waypoint x="440" y="1140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_approuver_se_transmettre" bpmnElement="sf_approuver_se_to_transmettre_approuves">
        <di:waypoint x="1000" y="280"/><di:waypoint x="1040" y="700"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_se_approuves_demander_obj" bpmnElement="sf_se_approuves_to_demander_obj">
        <di:waypoint x="1120" y="700"/><di:waypoint x="440" y="1300"/>
