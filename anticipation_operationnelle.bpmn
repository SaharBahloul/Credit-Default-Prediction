      <!-- Phase 2 -->
      <bpmndi:BPMNEdge id="edge_demander_obj_generer" bpmnElement="sf_demander_obj_to_generer">
        <di:waypoint x="440" y="1380"/><di:waypoint x="640" y="1780"/>
